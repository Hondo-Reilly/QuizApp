{
  "name": "quizapp",
  "version": "0.4.0",
  "private": true,
  "description": "Electron + React + Tailwind quiz app that imports JSON quizzes.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/check-desktop-assets.mjs",
    "build:web": "tsc -p tsconfig.json --noEmit && QUIZAPP_WEB=1 vite build",
    "build:mac": "npm run build && electron-builder --mac --arm64 --publish never && node scripts/check-packaged-app.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pack-quiz": "vite-node --config vitest.config.ts scripts/pack-quiz.ts --"
  },
  "build": {
    "appId": "com.quizapp.app",
    "productName": "QuizApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "icon": "Quiz App.icon/Assets/Quiz App.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "background": "build/background.png",
      "iconSize": 80,
      "contents": [
        {
          "x": 160,
          "y": 278
        },
        {
          "x": 480,
          "y": 278,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "markdown-it-texmath": "^1.0.0",
    "nanoid": "^5.0.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "2.1.9"
  }
}
